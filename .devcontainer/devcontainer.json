{
  "name": "hardware-shop-dev",
  "dockerComposeFile": [
    "../docker-compose.dev.yml",
    "docker-compose.yml"
  ],
  "service": "web-api",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      "extensions": [
        "ms-dotnettools.csharp",
        "eamodio.gitlens",
        "editorconfig.editorconfig",
        "formulahendry.dotnet-test-explorer",
        "ms-vscode.powershell",
        "openai.codex"
      ]
    }
  },
  "postCreateCommand": "dotnet restore",
  "mounts": [
    "source=${localEnv:USERPROFILE}/.codex,target=/root/.codex,type=bind,consistency=cached"
  ]
}
